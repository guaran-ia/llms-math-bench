# Gemini API
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL_ID=gemini-3.5-flash

# Azure credentials and shared Azure AI Services endpoint
AZURE_OPENAI_API_KEY=
AZURE_AI_SERVICES_ENDPOINT=

# Azure OpenAI GPT-4o mini
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_GPT4O_MINI_DEPLOYMENT=gpt-4o-mini
AZURE_GPT4O_MINI_MODEL_VERSION=2024-07-18

# Azure AI Services deployments
AZURE_GROK41_DEPLOYMENT=grok-4-1-fast-non-reasoning
AZURE_GROK41_MODEL_VERSION=1
AZURE_LLAMA33_DEPLOYMENT=Llama-3.3-70B-Instruct
AZURE_LLAMA33_MODEL_VERSION=9
AZURE_MISTRAL_LARGE3_DEPLOYMENT=Mistral-Large-3
AZURE_MISTRAL_LARGE3_MODEL_VERSION=1

# Optional: date you last verified Azure versions in the portal, ISO UTC
AZURE_MODEL_METADATA_PORTAL_CHECKED_AT_UTC=2026-11-12T17:15:12.858Z
